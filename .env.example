# Copier ce fichier en .env (ignoré par git), puis renseigner les valeurs.
# Ne jamais committer de valeur réelle.

# Fournisseurs LLM
GOOGLE_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=

# Langfuse auto-hébergé : traces et scores
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# DeepEval envoie de la télémétrie par défaut : 1 la désactive
DEEPEVAL_TELEMETRY_OPT_OUT=1
